---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { routePath } from '~/i18n/utils';
---

<BaseLayout
  lang="ar"
  title="الصفحة غير موجودة (404) | تكنو إنجاز"
  description="الصفحة التي تبحث عنها غير موجودة أو نُقلت إلى رابط جديد."
  path="/404/"
  noindex
>
  <section class="container section notfound">
    <p class="eyebrow">404</p>
    <h1>الصفحة غير موجودة</h1>
    <p>ربما نُقلت الصفحة أو تغيّر رابطها. جرّب إحدى الصفحات التالية:</p>
    <ul>
      <li><a href="/">الرئيسية</a></li>
      <li><a href={routePath('ar', 'projects')}>المشاريع الهندسية</a></li>
      <li><a href={routePath('ar', 'articles')}>المقالات</a></li>
      <li><a href={routePath('ar', 'contact')}>تواصل معنا</a></li>
    </ul>
    <div lang="en" dir="ltr" class="notfound__en">
      <h2>Page not found</h2>
      <p>The page may have moved. Try the <a href="/en/">English home page</a> or <a href="/en/contact/">contact us</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 44rem;
  }
  .notfound__en {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border);
    text-align: left;
  }
  .notfound__en h2 {
    font-size: var(--fs-xl);
  }
</style>
