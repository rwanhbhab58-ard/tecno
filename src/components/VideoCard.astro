---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Lang } from '~/data/site';
import type { Video } from '~/data/media';
import { t } from '~/i18n/utils';

interface Props {
  video: Video;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}

const { video, lang, headingLevel = 'h3' } = Astro.props;
const ui = t(lang);
const Heading = headingLevel;
const watchUrl = `https://www.youtube.com/watch?v=${video.youtubeId}`;
---

<article class="card video-card" id={video.id}>
  <div class="card__media video-card__media">
    <a
      class="video-facade"
      href={watchUrl}
      data-youtube-id={video.youtubeId}
      data-title={video.title[lang]}
      target="_blank"
      rel="noopener"
    >
      <Image src={video.cover} alt="" widths={[480, 720, 960]} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 92vw" loading="lazy" />
      <span class="video-facade__play"><Icon name="play" size={26} /></span>
      <span class="video-facade__duration ltr">{video.durationLabel}</span>
      <span class="visually-hidden">{ui.common.watch}: {video.title[lang]}</span>
    </a>
  </div>
  <div class="card__body">
    <span class="badge">{video.tag[lang]}</span>
    <Heading class="video-card__title">{video.title[lang]}</Heading>
    <p class="card__text">{video.description[lang]}</p>
    <p class="video-card__yt">
      <Icon name="youtube" size={16} />
      <a href={watchUrl} target="_blank" rel="noopener">YouTube <span class="visually-hidden">{ui.a11y.opensNewTab}</span></a>
    </p>
  </div>
</article>

<script>
  // Lightweight YouTube facade: the heavy player iframe loads only after a click.
  document.querySelectorAll<HTMLAnchorElement>('a.video-facade').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.dataset['youtubeId'];
      if (!id || event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = link.dataset['title'] ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'video-frame';
      link.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video-card__media {
    position: relative;
  }
  .video-facade {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    color: #fff;
  }
  .video-facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-facade__play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: rgb(6 19 29 / 0.78);
    border: 2px solid rgb(255 255 255 / 0.85);
    transition: transform 0.2s ease;
  }
  .video-facade__play :global(svg) {
    /* Optical centring of the play triangle, which points right in every script. */
    margin-left: 3px;
  }
  .video-facade:hover .video-facade__play {
    transform: scale(1.08);
  }
  .video-facade__duration {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-end: 0.6rem;
    padding: 0.1rem 0.5rem;
    border-radius: 0.4rem;
    background: rgb(6 19 29 / 0.82);
    font-size: var(--fs-xs);
  }
  :global(.video-frame) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-card__title {
    font-size: var(--fs-lg);
    margin: 0;
  }
  .video-card__yt {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: auto 0 0;
    font-size: var(--fs-sm);
  }
</style>
