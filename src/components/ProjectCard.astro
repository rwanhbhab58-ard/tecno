---
import Icon from './Icon.astro';
import type { Lang } from '~/data/site';
import { driveFileUrl, driveFolderUrl, projectCategories, type EngineeringProject } from '~/data/projects';
import { t } from '~/i18n/utils';

interface Props {
  project: EngineeringProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
const ui = t(lang);
const docs = project.docs;
type DocLink = { href: string; label: string; icon: 'file' | 'slides' | 'folder' };
const links: DocLink[] = [];
if (docs.pdf) links.push({ href: driveFileUrl(docs.pdf), label: ui.common.report, icon: 'file' });
if (docs.docx) links.push({ href: driveFileUrl(docs.docx), label: ui.common.doc, icon: 'file' });
if (docs.pptx) links.push({ href: driveFileUrl(docs.pptx), label: ui.common.slides, icon: 'slides' });
if (docs.folder) links.push({ href: driveFolderUrl(docs.folder), label: ui.common.folder, icon: 'folder' });
---

<article class="card project-card" id={project.id} data-category={project.category}>
  <div class="card__body">
    <span class="badge">{projectCategories[project.category][lang]}</span>
    <h3 class="project-card__title">{project.title[lang]}</h3>
    <p class="card__text">{project.description[lang]}</p>
    <ul class="tags" role="list">
      {project.tags[lang].map((tag) => <li class="badge badge--outline">{tag}</li>)}
    </ul>
    <div class="card__footer">
      <span class="visually-hidden">{ui.common.documentation}:</span>
      {
        links.map((l) => (
          <a class="doc-link" href={l.href} target="_blank" rel="noopener">
            <Icon name={l.icon} size={16} />
            {l.label}
            <span class="visually-hidden">{ui.a11y.opensNewTab}</span>
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .project-card__title {
    font-size: var(--fs-lg);
    margin: 0;
  }
  .doc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
  }
  .doc-link:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
</style>
