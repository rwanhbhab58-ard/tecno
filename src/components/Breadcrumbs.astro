---
import type { Lang } from '~/data/site';
import { t } from '~/i18n/utils';
import type { Crumb } from '~/lib/schema';

interface Props {
  lang: Lang;
  crumbs: Crumb[];
}

const { lang, crumbs } = Astro.props;
---

<nav class="breadcrumbs container" aria-label={t(lang).a11y.breadcrumb}>
  <ol role="list">
    {
      crumbs.map((c, i) => (
        <li>
          {i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding-block: var(--space-3) 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li:not(:last-child)::after {
    content: '/';
    margin-inline-start: var(--space-2);
    color: var(--border-strong);
  }
  a {
    color: var(--text-muted);
  }
  a:hover {
    color: var(--link);
  }
  span[aria-current] {
    color: var(--text);
  }
</style>
